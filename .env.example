# VITE_GEMINI_API_KEY: Clé API Google Gemini pour Cloudflare Pages / Vite frontend.
# Nécessaire pour les appels directs via fetch côté client.
VITE_GEMINI_API_KEY="AIzaSy..."

# GEMINI_API_KEY: Required for Gemini AI API calls (backend/runtime secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
